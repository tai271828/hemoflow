# Makefile for hemoTai - Minimal MPI+HDF5 Demo Application
# Based on hemoFlow build patterns

# Compiler settings (adjust to match your environment)
CXX = mpic++
CXXFLAGS = -std=c++14 -O3 -Wall

# Palabos library paths (adjust to your installation)
PALABOS_ROOT = ./palabos
PALABOS_INCLUDE = -I$(PALABOS_ROOT)/src -I$(PALABOS_ROOT)/externalLibraries
PALABOS_LIB = ./build/libpalabos.a

# HDF5 settings (customize HDF5_ROOT if needed)
HDF5_ROOT ?= $(HOME)/work-my-projects/workspace-hemoflow/hdf5-installation
HDF5_INCLUDE = -I$(HDF5_ROOT)/include
HDF5_LIB = -L$(HDF5_ROOT)/lib -lhdf5 -lhdf5_hl
HDF5_RPATH = -Wl,-rpath,$(HDF5_ROOT)/lib

# HighFive header-only library
HIGHFIVE_INCLUDE = -I./external/HighFive/include

# Combined includes and libs
INCLUDES = $(PALABOS_INCLUDE) $(HDF5_INCLUDE) $(HIGHFIVE_INCLUDE)
LIBS = $(PALABOS_LIB) $(HDF5_LIB) $(HDF5_RPATH) -lz

# Target
TARGET = hemoTai

# Source files
SRCS = hemoTai.cpp

# Object files
OBJS = $(SRCS:.cpp=.o)

# Default target
all: $(TARGET)

# Build the executable
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LIBS)

# Compile object files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Clean
clean:
	rm -f $(OBJS) $(TARGET)
	rm -rf output_hemoTai

# Run with 4 MPI processes
run:
	mpirun -np 4 ./$(TARGET)

# Run with explicit LD_LIBRARY_PATH (alternative if rpath doesn't work)
run-ldpath:
	LD_LIBRARY_PATH=$(HDF5_ROOT)/lib:$$LD_LIBRARY_PATH mpirun -np 4 ./$(TARGET)

# Run with restart from checkpoint
run-restart:
	mpirun -np 4 ./$(TARGET) -r

# Help
help:
	@echo "Makefile for hemoTai"
	@echo ""
	@echo "Targets:"
	@echo "  all          - Build the executable (default)"
	@echo "  clean        - Remove build artifacts and output"
	@echo "  run          - Run with 4 MPI processes"
	@echo "  run-ldpath   - Run with explicit LD_LIBRARY_PATH"
	@echo "  run-restart  - Run with restart from checkpoint"
	@echo "  help         - Show this help"
	@echo ""
	@echo "Usage:"
	@echo "  make              # Build"
	@echo "  make run          # Run normally"
	@echo "  make run-restart  # Restart from checkpoint"
	@echo ""
	@echo "Adjust paths in Makefile to match your system:"
	@echo "  - PALABOS_ROOT: Path to Palabos library"
	@echo "  - HDF5_ROOT: HDF5 installation root (default: \$$HOME/work-my-projects/workspace-hemoflow/hdf5-installation)"
	@echo "  - HIGHFIVE_INCLUDE: HighFive header path"
	@echo ""
	@echo "Note: If you get 'libhdf5.so cannot open shared object' errors,"
	@echo "      rebuild with 'make clean && make' to embed rpath, or use 'make run-ldpath'"

.PHONY: all clean run run-ldpath run-restart help
