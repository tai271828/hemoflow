
    <simulation>
        <dt>6e-5</dt>	<!-- Time step [s] -->
        <blockSize>50</blockSize>
        <outputDir>output_quick_main</outputDir>
        <simLength>0.8</simLength> <!-- [s]; startup time constant R^2/(5.78 nu) ~ 0.21 s -->
        <saveFrequency>0.1</saveFrequency> <!-- [s] -->
    </simulation>

    <geometry>
        <file>input/vox_quick_c.npz</file>
        <!-- Opening types: 1 - Velocity; 2 - Murray (velocity); 3 - Pressure; 4 - Freeflow -->
        <!-- Both outlets are pressure openings at 0 Pa, so the flow split is set
             by the branch resistances (resistance-network oracle). Labels 11/12
             map to the two outlets; both get the same type so the mapping order
             does not matter. -->
        <opening_0>
            <name>Inlet</name>
            <type>1</type>
            <label>10</label>
            <timeScaleFunction>input/stationary.txt</timeScaleFunction>
            <parameter>0.11</parameter> <!-- mean inlet velocity [m/s] -->
        </opening_0>
        <opening_1>
            <name>Outlet A</name>
            <type>3</type>
            <label>11</label>
            <timeScaleFunction></timeScaleFunction>
            <parameter>0</parameter> <!-- [Pa] -->
        </opening_1>
        <opening_2>
            <name>Outlet B</name>
            <type>3</type>
            <label>12</label>
            <timeScaleFunction></timeScaleFunction>
            <parameter>0</parameter> <!-- [Pa] -->
        </opening_2>
    </geometry>

    <flowdiverter>
        <linCoeff>0</linCoeff>
        <quadCoeff>0</quadCoeff>
    </flowdiverter>
